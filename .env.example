# ParkSpot Environment Variables Template

# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/parkspot

# Authentication & Encryption
JWT_SECRET=your_jwt_secret_here_min_32_chars
TOTP_ENCRYPTION_KEY=your_32_byte_hex_totp_encryption_key
MFA_MAX_ATTEMPTS=5
MFA_CHALLENGE_TTL_MINUTES=15

# Payments (Razorpay - Optional in dev / test mode)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# AI & Optimization (Google Gemini - Optional)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# Frontend (Vite)
VITE_MAPBOX_TOKEN=your_mapbox_public_token
